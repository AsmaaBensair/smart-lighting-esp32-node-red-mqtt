    {
        "id": "db8eaebfcae1c1d3",
        "type": "function",
        "z": "377f07d62cc18955",
        "name": "meteo -> theme",
        "func": "const clouds = Number(msg.payload?.clouds ?? 0);\nconst desc = String(msg.payload?.desc ?? '').toLowerCase();\nlet emoji='🌤️', label='Variable', theme='cloudy';\nif (desc.includes('rain') || desc.includes('pluie') || desc.includes('drizzle') || desc.includes('storm') || desc.includes('thunder')) { emoji='🌧️'; label='Pluie'; theme='rain'; }\nelse if (desc.includes('clear') || desc.includes('sun') || desc.includes('soleil')) { emoji='☀️'; label='Ensoleillé'; theme='sun'; }\nelse {\n  if (clouds <= 20) { emoji='☀️'; label='Ensoleillé'; theme='sun'; }\n  else if (clouds <= 50) { emoji='🌤️'; label='Partiellement nuageux'; theme='cloudy'; }\n  else if (clouds <= 80) { emoji='☁️'; label='Nuageux'; theme='cloudy'; }\n  else { emoji='☁️'; label='Très nuageux'; theme='cloudy'; }\n}\nmsg.payload = { emoji, label, clouds, desc, theme };\nreturn msg;",
