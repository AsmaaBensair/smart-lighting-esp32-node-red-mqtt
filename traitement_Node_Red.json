        "id": "fn_manual_mode",
        "type": "function",
        "z": "tab_marwa_prod",
        "name": "MANUEL: mode auto/manuel + lock 10min",
        "func": "let mode = String(msg.payload?.mode || '').toLowerCase();\nif (!mode) return null;\n\nflow.set('mode', mode);\nflow.set('source', 'manuel');\nflow.set('manualLockUntil', Date.now() + 10*60*1000);\n\nreturn [\n  { payload: { source: 'manuel' } },\n  { payload: mode }\n];",
