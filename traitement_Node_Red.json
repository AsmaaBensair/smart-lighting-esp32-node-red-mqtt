    {
        "id": "fn_weather_extract",
        "type": "function",
        "z": "tab_marwa_prod",
        "name": "Extract météo -> flow + status/meteo",
        "func": "const clouds = Number(msg.payload?.clouds?.all ?? 0);\nconst desc = String(msg.payload?.weather?.[0]?.main ?? '').toLowerCase();\n\nflow.set('meteo_clouds', clouds);\nflow.set('meteo_desc', desc);\nflow.set('meteo_ts', Date.now());\n\nmsg.payload = { clouds, desc };\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
