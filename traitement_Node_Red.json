    {
        "id": "fn_auto_weather",
        "type": "function",
        "z": "tab_marwa_prod",
        "name": "AUTO: lux + météo -> pct (si pas lock manuel)",
        "func": "let lockUntil = flow.get('manualLockUntil') || 0;\nif (Date.now() < lockUntil) return null;\n\nlet lux = Number(msg.payload?.lux);\nif (Number.isNaN(lux)) return null;\n\nlet clouds = Number(flow.get('meteo_clouds') ?? 0);\nlet desc = String(flow.get('meteo_desc') ?? '');\n\nlet pct;\nif (lux > 700) pct = 20;\nelse if (lux >= 300) pct = 60;\nelse pct = 100;\n\nif (clouds >= 80) pct += 20;\nelse if (clouds >= 50) pct += 10;\nelse if (clouds <= 20 || desc.includes('clear')) pct -= 15;\n\npct = Math.max(0, Math.min(100, pct));\n\nflow.set('source', 'auto');\nflow.set('mode', 'auto');\nflow.set('lastPct', pct);\n\nreturn [\n  { payload: { pct: pct } },\n  { payload: { pct: pct } },\n  { payload: { source: 'auto' } },\n  { payload: 'auto' }\n];",
        "outputs": 4,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 200,
        "wires": [
            [
                "out_cmd_int"
            ],
            [
                "out_status_int"
            ],
            [
                "out_status_source"
            ],
            [
                "out_status_mode"
            ]
        ]
    },
