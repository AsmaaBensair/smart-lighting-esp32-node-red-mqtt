    {
        "id": "fn_scene_apply",
        "type": "function",
        "z": "tab_marwa_prod",
        "name": "SCENE -> intensité + couleur + lock 10min",
        "func": "let scene = String(msg.payload?.scene || '').toLowerCase();\nif (!scene) return null;\n\nflow.set('source','manuel');\nflow.set('manualLockUntil', Date.now() + 10*60*1000);\nflow.set('mode', scene);\n\nlet pct = 60;\nlet couleur = '255,255,255';\n\nif(scene === 'detente') { pct = 40; couleur = '255,140,0'; }\nelse if(scene === 'concentration') { pct = 70; couleur = '0,120,255'; }\nelse if(scene === 'reunion') { pct = 80; couleur = '255,255,255'; }\nelse if(scene === 'energie') { pct = 55; couleur = '0,255,120'; }\n\nflow.set('lastPct', pct);\n\nreturn [\n  { payload: { pct: pct } },\n  { payload: { couleur: couleur } },\n  { payload: { source: 'manuel' } },\n  { payload: scene },\n  { payload: { pct: pct } }\n];",
